# 语音机侧环境变量（Linux/macOS 用 export，Windows 用 set 或系统环境变量）
# 复制成你自己的一份，别把真实地址推回仓库。

# ---- 大脑（另一台机器）----
# 不给就只靠下面两个去发现：先试 VOICE_BRAIN，再试 FALLBACKS，最后扫 VOICE_ICS_PREFIX 网段
VOICE_BRAIN=http://192.168.137.10:8777
VOICE_BRAIN_FALLBACKS=
VOICE_ICS_PREFIX=192.168.137.

# ---- 本机三个音频服务 ----
VOICE_VAD=http://127.0.0.1:9884
VOICE_ASR=http://127.0.0.1:9883
VOICE_TTS=http://127.0.0.1:9880

# ---- TTS ----
# 参考音：3~10 秒、干声、单人；不给则 /tts 返回 502
VOICE_REF=
VOICE_PROMPT=
VOICE_PROMPT_LANG=zh
# 0=关。给了截止频率就做 4 阶低通（削高频毛刺，代价是齿音变钝）
VOICE_LP=0

# ---- 唤醒（不给模型路径 = 不启用，只认客户端发的 force）----
VOICE_KWS_V1=
VOICE_KWS_HEY=
VOICE_KWS_TH_V1=0.93
VOICE_KWS_TH_HEY=0.99
VOICE_KWS_FRAMES=2
# 1=命中后用 ASR 复核缓冲文本（强烈建议开：实测 0.999 分也可能说的是「哎呀」）
VOICE_KWS_ASR=1
# 留证 wav 落盘目录（空=不落）
VOICE_DUMP_DIR=
VOICE_KWS_DUMP=1

# ---- 信箱 ----
# 空 = 拒绝所有写操作；两台机必须配同一个口令
MAIL_KEY=

# ---- 看门狗（hub.py）----
# 建议指向虚拟环境的 pythonw.exe；空=用当前解释器
HUB_PYW=
# 托管外部 TTS/ASR 工程时才需要
HUB_TTS_PY=
HUB_TTS_DIR=
HUB_TTS_CFG=GPT_SoVITS/configs/tts_infer.yaml
HUB_ASR_PY=
HUB_ASR_SCRIPT=
